    # ==============================================================================
# HYT ATS - Environment Variables & API Key Template
# ==============================================================================
# Copy this file to .env and fill in your actual credentials.
# NEVER commit the actual .env file to Git!
# ==============================================================================

# LLM Providers (at least one required for extraction & explanations)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# GitHub API Token (Optional: increases rate limit from 60 to 5,000 req/hr for Gate 4)
GITHUB_TOKEN=your_github_personal_access_token_here

# Dynamic Pipeline Threshold Overrides (Optional - defaults loaded from config.yaml)
# HYT_LLM_MODEL=gpt-4o-mini
# HYT_GATE7_HIGH_THRESHOLD=75.0
# HYT_GATE7_LOW_THRESHOLD=40.0
# HYT_LOG_LEVEL=INFO
