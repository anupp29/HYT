# ==============================================================================
# HYT ATS - Git Ignore Rules
# ==============================================================================

# Raw and processed data - never commit PII or applicant resumes
data/raw/
data/sample/
data/adversarial/

# LLM cache & Embedding models - regenerable, not source code
cache/
*.pkl
*.sqlite
*.sqlite-journal

# Logs & Diagnostics
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Python environment & bytecode
.env
.env.*
!.env.example
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/
env/
.pytest_cache/

# Node & Frontend dependencies
node_modules/
*/node_modules/
ui/node_modules/
.pnp
.pnp.js

# Testing & Coverage
coverage/
*.coverage
.nyc_output/

# Build artifacts & distribution
dist/
ui/dist/
dist-ssr/
build/
*.egg-info/
.vite/
ui/.vite/

# OS and Editor files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Evaluation packages & scratch directories
check/
scratch/
recruiter_annotation_kit.zip
recruiter_annotation_kit/
/recruiter_human_labels.csv
a.txt
sample2.json
*.tmp
ui/node_modules/
node_modules/

# Golden Set Policy:
# Canonical labels live inside data/golden/ (tracked)
# No raw resumes or PII PDFs are ever committed
